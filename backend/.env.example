# ==========================================
# VARIÁVEIS DE AMBIENTE - BACKEND (Node.js / Express / PostgreSQL)
# Configure estas variáveis no Web Service do Render ou no ambiente local.
# ==========================================

PORT=3000
NODE_ENV=production

# Conexão com o banco de dados PostgreSQL do Render.
# Pode ser usada a URL de conexão direta ou os campos separados:
DATABASE_URL=postgresql://usuario:senha@host-do-banco.com:5432/gestao_igreja?sslmode=require

# Campos individuais (usados pelo backend/db.js):
DB_HOST=host-do-banco.com
DB_PORT=5432
DB_NAME=gestao_igreja
DB_USER=usuario
DB_PASSWORD=sua_senha_segura
DB_SSL=true

# Origem permitida para requisições CORS (Static Site no Render).
CORS_ORIGIN=https://igrejaemluanda.onrender.com

# Segredo para autenticação JWT / Sessão (se aplicável)
JWT_SECRET=gere_uma_chave_secreta_longa_e_aleatoria_aqui

