# =======================================================
# VARIÁVEIS DE AMBIENTE - DEPLOY NO RENDER.COM
# =======================================================
# No painel do Render, vá em:
# Seu Web Service (Backend) -> Environment -> "Add Environment Variable"
# ou use "Add from .env" e cole o conteúdo abaixo.

# 1. Configurações do Servidor
NODE_ENV=production
PORT=10000

# 2. Conexão com o PostgreSQL no Render
# DICA: Quando você cria um banco PostgreSQL no Render, ele gera duas URLs:
# - "Internal Database URL" (USE ESTA se o Backend e o Banco estiverem no Render - é mais rápida e gratuita de tráfego)
# - "External Database URL" (para conectar de fora do Render)
# Configure DATABASE_URL manualmente no painel do serviço, colando a Internal Database URL completa.
# Não use um host de exemplo como "dpg-xxxxxx-a": ele não existe e causa erro ENOTFOUND.
# Não deixe a variável vazia nem use "Add from .env" para esta configuração.

# 3. URL do Static Site no Render (origem permitida pelo CORS)
CORS_ORIGIN=https://igrejaemluanda.onrender.com

# 4. Chave Secreta para Tokens / Autenticação (JWT)
JWT_SECRET=defina_uma_chave_secreta_longa_e_aleatoria_para_producao

