# ==========================================
# GUIA DE VARIÁVEIS DE AMBIENTE PARA VERCEL
# ==========================================
# Se você estiver fazendo o deploy do FRONTEND (pasta frontend) na Vercel:
# Acesse o painel da Vercel: Projeto -> Settings -> Environment Variables
#
# 1. URL da API backend (onde o backend/server.js estiver hospedado):
VITE_API_URL=https://api-gestao-igreja.onrender.com

# 2. Ambiente da aplicação:
VITE_APP_ENV=production

# 3. Nome da aplicação:
VITE_APP_NAME="Gestão Eclesiástica I.E.L"

# ==========================================
# (OPCIONAL) SE O BACKEND TAMBÉM FOR PARA A VERCEL:
# ==========================================
# Credenciais do Banco PostgreSQL (ex: Supabase, Neon, Railway)
# DB_HOST=seu-host-postgresql.com
# DB_PORT=5432
# DB_NAME=gestao_igreja
# DB_USER=postgres
# DB_PASSWORD=sua_senha
# DATABASE_URL=postgresql://postgres:sua_senha@seu-host.com:5432/gestao_igreja?sslmode=require
# CORS_ORIGIN=https://seu-projeto.vercel.app

